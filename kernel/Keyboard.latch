latch 1

// Tastatur: PS/2, Tastencodes Satz 1

public type Scan = Int where it in 0..255

public enum KbdError { BadDevice }

public function read_scan()
    -> Scan fails KbdError
    uses Port(0x60)
    ensures result in 0..255
    assumes "PS/2 data port at 0x60"
{
    let code = check Port.read(0x60)
        as Scan
        otherwise return BadDevice
    return code
}

function pick(keys: Text, i: Int)
    -> Int
{
    return List.at(Text.bytes(keys), i)
        otherwise return 0
}

// Tastencode -> Zeichen, 0 = keines.
// Bit 7 gesetzt: Taste losgelassen.
public function decode(code: Scan) -> Int
    ensures result in 0..127
{
    if Bits.test(code, 7) { return 0 }
    if code == 0x39 { return 32 }
    if code in 0x10..0x19 {
        return pick("qwertyuiop",
                    code - 0x10)
    }
    if code in 0x1E..0x26 {
        return pick("asdfghjkl",
                    code - 0x1E)
    }
    if code in 0x2C..0x32 {
        return pick("zxcvbnm",
                    code - 0x2C)
    }
    return 0
}

test "a" { return decode(0x1E) == 97 }

test "Leertaste" {
    return decode(0x39) == 32
}

test "losgelassen zaehlt nicht" {
    return decode(0x9E) == 0
}
