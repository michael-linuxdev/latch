latch 1

enum State { Ready, Finished }

type Task = {
    name: Text,
    left: Int,
    state: State,
}

// Der Wechsel selbst ist Assembler:
assembly function switch_to(id: Int)
    uses Cpu
    assumes "saves and loads all registers"

function log(msg: Text)
    uses Port(0x3F8)
{
    for b in Text.bytes(msg) {
        Port.write(0x3F8, b)
    }
    Port.write(0x3F8, 10)
}

function task(name: Text, left: Int)
    -> Task
{
    return Task { name, left,
                  state: Ready }
}

// Reihum die naechste bereite Aufgabe,
// -1 wenn keine mehr wartet
function pick(tasks: Table<Task, 3>,
              last: Int)
    -> Int
    requires last in 0..2
    ensures result in -1..2
{
    for k in 1..3 {
        let i = (last + k) % 3
        let t = tasks[i]
        if t.state == Ready { return i }
    }
    return -1
}

// Eine Zeitscheibe fuer Aufgabe i
function step(change tasks: Table<Task, 3>,
              i: Int)
    uses Port(0x3F8), Cpu
    requires i in 0..2
{
    switch_to(i)
    let t = tasks[i]
    log("{t.name} arbeitet")
    tasks[i].left = t.left - 1
    if t.left == 1 {
        tasks[i].state = Finished
    }
}

function main()
    uses Port(0x3F8), Cpu
{
    var tasks = [
        task("editor", 2),
        task("backup", 3),
        task("uhr", 1),
    ]
    var next = pick(tasks, 2)
    while next >= 0 {
        step(change tasks, next)
        next = pick(tasks, next)
    }
    log("alle Aufgaben fertig")
}